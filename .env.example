# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_USERS_COLLECTION_ID=users
VITE_APPWRITE_STORIES_COLLECTION_ID=stories
VITE_APPWRITE_ADMIN_LOGS_COLLECTION_ID=admin_logs
VITE_APPWRITE_ERROR_LOGS_COLLECTION_ID=error_logs
VITE_APPWRITE_STORY_IMAGES_BUCKET_ID=storytelling-images

# Authentication Settings
VITE_APPWRITE_SESSION_DURATION=86400
VITE_APPWRITE_EMAIL_VERIFICATION=true
VITE_APPWRITE_RATE_LIMIT_LOGIN=10
VITE_APPWRITE_RATE_LIMIT_REGISTER=5
VITE_APPWRITE_RATE_LIMIT_PASSWORD_RESET=3

# Encryption Settings
VITE_ENCRYPTION_KEY=your-encryption-key

# Vercel Settings (optional)
VITE_VERCEL_URL=your-vercel-url