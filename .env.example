# Universal Felearn Configuration
# This works with ANY domain automatically!

# Appwrite Configuration (Required)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=felearn

# Gemini Fallback API Keys (for beta access and rate limiting)
# During beta, users can enter "FREE" to use these keys
VITE_GEMINI_FALLBACK_API_KEY_1=your_first_fallback_api_key_here
VITE_GEMINI_FALLBACK_API_KEY_2=your_second_fallback_api_key_here
VITE_GEMINI_FALLBACK_API_KEY_3=your_third_fallback_api_key_here

# Production Domain (Optional)
# Override the production domain for email verification URLs
# Only needed if your production domain is different from felearn.vercel.app
# VITE_PRODUCTION_DOMAIN=https://yourdomain.com

# Optional: Override default settings
# VITE_APP_NAME=Felearn
# VITE_APP_VERSION=1.0.0

# Note: No need to set domain-specific URLs!
# The app automatically detects and configures:
# - localhost:3000, localhost:5173, localhost:8080 → Uses production domain for emails
# - Any custom domain (mydomain.com, test.example.com, etc.) → Uses current domain
# - Vercel deployments (*.vercel.app) → Uses current domain
# - Netlify deployments (*.netlify.app) → Uses current domain
# - Any other hosting platform → Uses current domain

# Email verification works automatically! 📧✨