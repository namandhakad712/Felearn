# Felearn AI Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPWRITE CONFIGURATION (Required)
# =============================================================================
# Get these from your Appwrite console: https://cloud.appwrite.io/console

# Appwrite API Endpoint
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Your Appwrite Project ID
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# Database ID (create in Appwrite console)
VITE_APPWRITE_DATABASE_ID=your_database_id_here

# Collection IDs (create these collections in your database)
VITE_APPWRITE_COLLECTION_STORIES_ID=your_stories_collection_id
VITE_APPWRITE_COLLECTION_USERS_ID=your_users_collection_id

# Storage Bucket ID (create in Appwrite console)
VITE_APPWRITE_BUCKET_STORY_IMAGES_ID=your_bucket_id_here

# =============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =============================================================================

# Vercel Analytics (optional)
# Get from: https://vercel.com/analytics
VITE_VERCEL_ANALYTICS_ID=your_analytics_id

# Google Analytics (optional)
# Get from: https://analytics.google.com
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Monitoring (optional)
# Get from: https://sentry.io
VITE_SENTRY_DSN=your_sentry_dsn

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Enable debug mode (true/false)
VITE_DEBUG_MODE=true

# API Rate Limiting (requests per minute)
VITE_API_RATE_LIMIT=60

# =============================================================================
# SOCIAL MEDIA & SEO
# =============================================================================

# Social media handles (for meta tags)
VITE_TWITTER_HANDLE=@FeLearnAI
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable/disable features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Fill in your Appwrite credentials (required)

# 3. Set up your Appwrite project:
#    - Create a new project at https://cloud.appwrite.io
#    - Create a database
#    - Create collections for 'stories' and 'users'
#    - Create a storage bucket for 'story-images'
#    - Enable authentication providers (email, OAuth)

# 4. Optional: Add analytics and monitoring services

# 5. Start development:
#    npm run dev

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Never commit .env files to version control
# - Use different values for development, staging, and production
# - Rotate API keys regularly
# - Use environment-specific Appwrite projects for security

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================

# For Vercel deployment:
# 1. Add all VITE_* variables to your Vercel project settings
# 2. Set NODE_ENV=production for production builds
# 3. Ensure your Appwrite project allows your domain in CORS settings

# For other platforms:
# - Ensure all VITE_* variables are available during build time
# - Set appropriate NODE_ENV for each environment