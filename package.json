{
  "name": "felearn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "deploy": "node scripts/deploy.js",
    "deploy:prod": "NODE_ENV=production node scripts/deploy.js --prod",
    "deploy:functions": "node scripts/deploy-functions.js",
    "vercel:build": "node scripts/vercel-build.js",
    "analyze": "node analyze-bundle.js",
    "create-indexes": "tsx src/scripts/create-indexes.ts"
  },
  "dependencies": {
    "@genkit-ai/googleai": "^1.15.2",
    "@google/genai": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "appwrite": "^18.1.1",
    "chart.js": "^4.5.0",
    "framer-motion": "^11.0.8",
    "jspdf": "^2.5.1",
    "marked": "^15.0.7",
    "node-appwrite": "^17.0.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.22.2",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "~5.3.3",
    "vite": "^5.1.4"
  }
}
